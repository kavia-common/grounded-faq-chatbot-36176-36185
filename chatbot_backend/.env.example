# Copy this file to .env and fill in your local secrets (do NOT commit the .env file).
# This example is for local development only. In production, set these as container/service env vars.

# OpenAI
OPENAI_API_KEY="sk-..."  # required

# Database (Postgres + pgvector)
DATABASE_URL="postgresql+psycopg://user:pass@host:5432/dbname"  # required

# Models (defaults shown here)
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# RAG settings
RAG_TOP_K="4"

# Server
HOST="0.0.0.0"
PORT="8080"
