# Copy this file to .env for local development (do NOT commit your real secrets)
# The application also reads environment variables from the runtime environment.

# Required for RAG/GPT features
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database (Postgres with pgvector)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Server bind configuration
HOST=0.0.0.0
PORT=8080

# Weather integration
# Obtain a free API key from https://openweathermap.org/api
# Used to answer questions like "today's weather in Pune".
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
