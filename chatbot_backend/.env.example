````write file="grounded-faq-chatbot-36176-36185/chatbot_backend/app/main.py"
from fastapi import FastAPI, Depends, HTTPException
from fastapi.responses import StreamingResponse, JSONResponse, PlainTextResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from typing import List, Optional, AsyncGenerator, Dict, Any
import asyncio
import json
import uuid

from .settings import Settings, get_settings
from .rag import retrieve_context_with_refs, OpenAIChatStreamer
from .schemas import ChatMessage, AskRequest, Reference
from .ingest import IngestRequest, ingest_documents, reindex_all
from .db.session import ensure_db_ready

app = FastAPI(
    title="Ocean Chat Backend",
    version="0.1.0",
    description="RAG backend for Ocean Chat: OpenAI + Postgres/pgvector with streaming NDJSON.",
    openapi_tags=[
        {"name": "chat", "description": "Chat endpoints (RAG, streaming)"},
        {"name": "ingest", "description": "Document ingestion and reindexing"},
        {"name": "info", "description": "Health, usage, and websocket notes"},
    ],
)

# Simple CORS; adjust as needed per environment
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Production: restrict to your frontend origin
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.on_event("startup")
async def _on_startup():
    # Ensure DB schema exists
    await ensure_db_ready()


# PUBLIC_INTERFACE
@app.get("/", tags=["info"])
def root() -> Dict[str, Any]:
    """Root entry for backend."""
    return {"status": "ok", "service": "ocean-chat-backend"}


# PUBLIC_INTERFACE
@app.get("/api/docs/websocket-usage", tags=["info"])
def websocket_info() -> Dict[str, Any]:
    """
    Returns information about potential WebSocket streaming (not implemented in this version).
    """
    return {
        "note": "This API uses HTTP streaming NDJSON. WebSocket endpoints may be added later."
    }


# PUBLIC_INTERFACE
@app.post("/api/ask", tags=["chat"], summary="Ask a question with RAG", description="Streams NDJSON with tokens and references.")
async def api_ask(payload: AskRequest, settings: Settings = Depends(get_settings)):
    """
    STREAMING ENDPOINT: Returns NDJSON lines with types: start, token, refs, done, or error.
    - Accepts a prompt and optional history.
    - Performs retrieval using pgvector against stored documents.
    - Streams OpenAI tokens as they arrive and emits references.
    """
    message_id = str(uuid.uuid4())

    async def ndjson_stream() -> AsyncGenerator[bytes, None]:
        # Emit start
        yield (json.dumps({"type": "start", "messageId": message_id}) + "\n").encode("utf-8")
        try:
            # Retrieve context + refs from DB
            context_text, refs = await retrieve_context_with_refs(
                query=payload.prompt,
                top_k=settings.RAG_TOP_K,
                settings=settings,
            )
            # Emit refs (even if empty, for stable UI)
            refs_payload = [{"title": r.title, "url": r.url, "snippet": r.snippet} for r in refs]
            yield (json.dumps({"type": "refs", "value": refs_payload}) + "\n").encode("utf-8")

            # Stream tokens from OpenAI
            streamer = OpenAIChatStreamer(settings=settings)
            async for token in streamer.stream_chat(
                prompt=payload.prompt,
                history=payload.history or [],
                context=context_text,
            ):
                yield (json.dumps({"type": "token", "value": token}) + "\n").encode("utf-8")

            # Done
            yield (json.dumps({"type": "done"}) + "\n").encode("utf-8")
        except Exception as e:
            # Stream error as NDJSON
            yield (json.dumps({"type": "error", "error": str(e)}) + "\n").encode("utf-8")

    return StreamingResponse(ndjson_stream(), media_type="application/x-ndjson")


# PUBLIC_INTERFACE
@app.post("/api/ingest", tags=["ingest"], summary="Ingest documents", description="Placeholder ingestion: stores docs and generates embeddings.")
async def api_ingest(req: IngestRequest, settings: Settings = Depends(get_settings)):
    """
    Ingests an array of documents and generates embeddings for retrieval.
    """
    try:
        n = await ingest_documents(req.documents, settings=settings)
        return {"status": "ok", "ingested": n}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# PUBLIC_INTERFACE
@app.post("/api/reindex", tags=["ingest"], summary="Recompute embeddings", description="Recomputes embeddings for all stored docs (placeholder).")
async def api_reindex(settings: Settings = Depends(get_settings)):
    """
    Recomputes embeddings for all stored documents.
    """
    try:
        n = await reindex_all(settings=settings)
        return {"status": "ok", "updated": n}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
