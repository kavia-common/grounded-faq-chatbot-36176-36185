# Frontend environment variables (request these from the orchestrator; do NOT commit real secrets)
# Public URL to the backend service (FastAPI) that implements the real /api/ask
# Example: http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=

# Note: Do not expose your real OpenAI API key to the frontend. The backend should use OPENAI_API_KEY.
# The frontend does not require OPENAI_API_KEY.
# The orchestrator provided container_env list included NEXT_PUBLIC_OPENAI_API_KEY, but we will NOT use it
# to avoid leaking secrets to the client. Keep all model access on the backend.
