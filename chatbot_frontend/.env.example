# Copy this file to .env and set values as needed.
# Do not commit real secrets.

# If set, the frontend will proxy/forward /api/ask to this backend URL.
# Example for local dev if your backend runs on port 8000:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=

# Placeholder to show usage; do not expose real OpenAI keys in the browser.
# All model calls must happen on the backend.
NEXT_PUBLIC_OPENAI_API_KEY=
