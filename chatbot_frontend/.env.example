# Frontend environment variables (do not commit real secrets)
# URL where your backend is running. Used by next.config.ts for rewrite proxy.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Frontend-visible OpenAI API key placeholder if any client-side features are ever added.
# IMPORTANT: Do not expose real OpenAI keys in the frontend. Keep model calls on backend.
NEXT_PUBLIC_OPENAI_API_KEY=
